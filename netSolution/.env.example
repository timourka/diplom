# Скопируй этот файл в .env и поменяй секреты перед запуском:
# cp .env.example .env

API_PORT=5099
POSTGRES_DB=productsdate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password

# Минимум 32 символа. Должен совпадать с тем, чем будут подписываться JWT-токены.
JWT_SECRET=change_me_super_secret_32_chars_min_123456789
JWT_ISSUER=ProductsDateAPI
JWT_AUDIENCE=ProductsDateAPI
JWT_ACCESS_TOKEN_MINUTES=240

# Этот ключ должен совпадать с TRAINING_CLIENT_API_KEY на Python-клиенте обучения.
TRAINING_CLIENT_API_KEY=super_secret_training_key_2026

# Начальный административный профиль. Создаётся при старте API, если такого email ещё нет.
# Пароль записывается только при первом создании и не перезатирается при следующих запусках.
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@productsdate.local
ADMIN_PASSWORD=change_me_admin_password

# true — удобно для первого запуска: контейнер API сам применит EF Core миграции.
# После стабильного деплоя можно поставить false и применять миграции вручную.
APPLY_MIGRATIONS=true

# Для проверки API на сервере удобно true. Для продакшена можно поставить false.
SWAGGER_ENABLED=true
