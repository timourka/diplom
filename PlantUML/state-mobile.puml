@startuml
left to right direction
title Диаграмма состояний мобильного приложения (обновлено)

[*] --> Main

state "Главный экран\n(камера + детекция)" as Main
state "Экран авторизации" as Login
state "Экран регистрации" as Register
state "Личный кабинет\n(профиль + история сканирований)" as Cabinet
state "Форма ручного добавления\nпродукта" as ManualAdd
state "Экран сообщения об ошибке\n" as ErrorStub

' --- Переходы с главного экрана ---
Main --> Cabinet   : нажата иконка профиля\n[пользователь авторизован]
Main --> Login     : нажата иконка профиля\n[пользователь не авторизован]

Main --> ManualAdd : нажата кнопка\n"+" (ручное добавление)\n[пользователь авторизован]
Main --> Login     : нажата кнопка\n"+" (ручное добавление)\n[пользователь не авторизован]

Main --> ErrorStub : нажата кнопка\n"Сообщить об ошибке"\n[пользователь авторизован]
Main --> Login     : нажата кнопка\n"Сообщить об ошибке"\n[пользователь не авторизован]

Main --> [*]       : приложение закрыто

' --- Авторизация и регистрация ---
Login --> Register : нажата ссылка "Регистрация"
Register --> Login : регистрация успешна

' после успешной авторизации возвращаемся
' к запрошенному действию (упрощённо)
Login --> Main     : авторизация успешна\n(если вход "просто так")
Login --> Cabinet  : авторизация успешна\n(запрошен профиль)
Login --> ManualAdd: авторизация успешна\n(запрошено ручное добавление)
Login --> ErrorStub: авторизация успешна\n(запрошена отправка ошибки)
Login --> Main     : отмена авторизации
Login --> [*]      : приложение закрыто
Register --> [*]   : приложение закрыто

' --- Личный кабинет ---
Cabinet --> ManualAdd : нажата кнопка\n"Добавить вручную"
Cabinet --> Main      : кнопка "Назад" / возврат
Cabinet --> [*]       : приложение закрыто

' --- Ручное добавление ---
ManualAdd --> Cabinet : добавление сохранено\n(из кабинета)
ManualAdd --> Main    : добавление сохранено\n(с главного)
ManualAdd --> Cabinet : отмена\n(если открыто из кабинета)
ManualAdd --> Main    : отмена\n(если открыто с главного)
ManualAdd --> [*]     : приложение закрыто

' --- Сообщение об ошибке (пока заглушка) ---
ErrorStub --> Main  : назад
ErrorStub --> [*]   : приложение закрыто

@enduml
