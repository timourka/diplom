@startuml
skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #444444
  DiamondBackgroundColor #F7F7F7
  DiamondBorderColor #444444
  StartColor #2E7D32
  EndColor #C62828
  BarColor #444444
  ArrowColor #444444
}
skinparam defaultFontName Arial

title Блок-схема процесса инференса детектора области даты

start
:Получить изображение / кадр
с камеры, из файла или видеопотока;

if (Изображение получено?) then (Да)
else (Нет)
  :Вернуть ошибку / пустой результат;
  stop
endif

:Проверить формат кадра
и метаданные (размер, ориентация);

:Преобразовать исходный формат
(YUV/BGRA/др.) в RGB;

:Повернуть изображение
в рабочую ориентацию;

if (Нужна зеркальность?) then (Да)
  :Отразить по горизонтали;
else (Нет)
endif

:Выполнить letterbox/resize
до входного размера модели;

:Нормализовать пиксели
и сформировать входной тензор;

if (Модель квантованная?) then (Да)
  :Квантовать вход
(scale / zero point);
else (Нет)
endif

:Передать тензор в интерпретатор
YOLO/TFLite;

:Выполнить инференс модели;

:Получить выходной тензор
с кандидатами bbox, confidence, class;

if (Выход квантован?) then (Да)
  :Деквантовать выходной тензор;
else (Нет)
endif

:Распарсить выходные данные
в список кандидатов bbox;

:Отфильтровать по confidence;

if (Требуется NMS/Top-K?) then (Да)
  :Подавить дубликаты
и оставить лучшие боксы;
else (Нет)
endif

:Пересчитать координаты bbox
из пространства letterbox
в координаты исходного изображения;

if (Найдены области даты?) then (Да)
  :Сформировать список блоков с датой
(x1, y1, x2, y2, confidence);
  :Передать блоки в UI
для подсветки / дальнейшей обработки;
else (Нет)
  :Вернуть пустой список блоков;
endif

stop
@enduml
